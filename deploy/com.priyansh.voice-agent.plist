<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.priyansh.voice-agent</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/uv</string><string>run</string><string>python</string><string>-u</string><string>ui/server.py</string>
  </array>
  <key>WorkingDirectory</key><string>/Users/priyansh19/voice-agent</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/Applications/Ollama.app/Contents/Resources</string>
    <key>VOICE_AGENT_CONFIG</key><string>config.macmini.yaml</string>
    <key>PYTHONIOENCODING</key><string>utf-8</string>
    <key>PYTORCH_ENABLE_MPS_FALLBACK</key><string>1</string>
    <key>HOST</key><string>0.0.0.0</string>
    <key>PORT</key><string>8765</string>
    <key>HOME</key><string>/Users/priyansh19</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>StandardOutPath</key><string>/Users/priyansh19/voice-agent/out/agent.log</string>
  <key>StandardErrorPath</key><string>/Users/priyansh19/voice-agent/out/agent.log</string>
</dict>
</plist>
